{
  "family": "order-service-integration",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "<execution-role-arn>",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "volumes": [
    {
      "name": "spring-tmp"
    }
  ],
  "containerDefinitions": [
    {
      "name": "kafka",
      "image": "apache/kafka:4.1.0",
      "essential": false,
      "cpu": 384,
      "memory": 1024,
      "environment": [
        { "name": "KAFKA_NODE_ID", "value": "1" },
        { "name": "KAFKA_PROCESS_ROLES", "value": "broker,controller" },
        { "name": "KAFKA_LISTENERS", "value": "CONTROLLER://:9093,PLAINTEXT://:9092" },
        { "name": "KAFKA_ADVERTISED_LISTENERS", "value": "PLAINTEXT://localhost:9092" },
        { "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP", "value": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT" },
        { "name": "KAFKA_CONTROLLER_LISTENER_NAMES", "value": "CONTROLLER" },
        { "name": "KAFKA_CONTROLLER_QUORUM_VOTERS", "value": "1@localhost:9093" },
        { "name": "KAFKA_INTER_BROKER_LISTENER_NAME", "value": "PLAINTEXT" },
        { "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR", "value": "1" },
        { "name": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR", "value": "1" },
        { "name": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR", "value": "1" },
        { "name": "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS", "value": "0" },
        { "name": "KAFKA_NUM_PARTITIONS", "value": "3" },
        { "name": "KAFKA_HEAP_OPTS", "value": "-Xms256m -Xmx512m" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1"],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service-session-08",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16-alpine",
      "essential": false,
      "cpu": 192,
      "memory": 512,
      "environment": [
        { "name": "POSTGRES_DB", "value": "orders" },
        { "name": "POSTGRES_USER", "value": "orders" },
        { "name": "POSTGRES_PASSWORD", "value": "orders-session-08-only" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U orders -d orders"],
        "interval": 5,
        "timeout": 3,
        "retries": 10,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service-session-08",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "order-service",
      "image": "<repository-uri>:session-08",
      "essential": false,
      "cpu": 384,
      "memory": 1024,
      "user": "10001",
      "readonlyRootFilesystem": true,
      "mountPoints": [
        {
          "sourceVolume": "spring-tmp",
          "containerPath": "/app/tmp",
          "readOnly": false
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "database" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://localhost:5432/orders" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "orders" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "value": "orders-session-08-only" },
        { "name": "SPRING_KAFKA_BOOTSTRAP_SERVERS", "value": "localhost:9092" },
        { "name": "JAVA_TOOL_OPTIONS", "value": "-Djava.io.tmpdir=/app/tmp -XX:MaxRAMPercentage=70" }
      ],
      "dependsOn": [
        { "containerName": "kafka", "condition": "HEALTHY" },
        { "containerName": "postgres", "condition": "HEALTHY" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf \"GET /actuator/health HTTP/1.0\\r\\n\\r\\n\" >&3 && grep -q UP <&3'"],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service-session-08",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "smoke-test",
      "image": "postgres:16-alpine",
      "essential": true,
      "cpu": 64,
      "memory": 256,
      "readonlyRootFilesystem": true,
      "entryPoint": ["sh", "-ec"],
      "command": [
        "response=\"$(wget -qO- --header='Content-Type: application/json' --post-data='{\"customerId\":\"fargate-smoke\",\"totalAmount\":49.90}' http://127.0.0.1:8080/orders)\"\necho \"POST /orders response: $response\"\nattempt=1\nwhile [ \"$attempt\" -le 15 ]; do\n  count=\"$(psql -h 127.0.0.1 -U orders -d orders -tAc \"SELECT COUNT(*) FROM order_projection WHERE customer_id = 'fargate-smoke'\")\"\n  if [ \"$count\" = \"1\" ]; then\n    echo \"PASS: projection found in PostgreSQL\"\n    exit 0\n  fi\n  echo \"Waiting for Kafka consumer projection (attempt $attempt)\"\n  sleep 2\n  attempt=$((attempt + 1))\ndone\necho \"FAIL: projection was not created\" >&2\nexit 1"
      ],
      "environment": [
        { "name": "PGPASSWORD", "value": "orders-session-08-only" }
      ],
      "dependsOn": [
        { "containerName": "order-service", "condition": "HEALTHY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/order-service-session-08",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

